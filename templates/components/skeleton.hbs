<div class="ah-skeleton{{#if circle}} ah-skeleton-circle{{/if}}{{#if wave}} ah-skeleton-wave{{/if}}"
     style="width:{{#if width}}{{width}}{{else}}100%{{/if}};height:{{#if height}}{{height}}{{else}}100%{{/if}};{{#if radius}}border-radius:{{radius}};{{/if}}"
     aria-hidden="true">
    {{#if label}}
        <span class="ah-skeleton__label">{{label}}</span>
    {{/if}}
</div>
